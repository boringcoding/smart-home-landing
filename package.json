{
  "name": "smart-house-business",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "validate:scene": "tsx scripts/validate-scene.ts"
  },
  "overrides": { "esbuild": "$esbuild" },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.3.0",
    "@gltf-transform/extensions": "4.3.0",
    "@gltf-transform/functions": "4.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.0.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
